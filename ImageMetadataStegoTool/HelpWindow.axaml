<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
        x:Class="ImageMetadataStegoTool.HelpWindow"
        Title="Справка" MaxWidth="600" MaxHeight="530" MinWidth="350" MinHeight="300" 
        WindowStartupLocation="CenterOwner"
        Background="#161520"
        Foreground="#CFD8DC">
	<Grid Margin="40,20,10,20">

		<md:MarkdownScrollViewer x:Name="HelpContentMarkdown"
                                 Markdown="Загрузка..."
                                 MaxWidth="600"
                                 HorizontalAlignment="Left">

			<md:MarkdownScrollViewer.Styles>
				<Style Selector="TextBlock">
					<Setter Property="FontWeight" Value="Regular"/>
					<Setter Property="LineHeight" Value="24"/>
					<Setter Property="Margin" Value="0,0,0,10"/>
				</Style>

				<Style Selector="TextBlock.Heading1">
					<Setter Property="FontWeight" Value="Bold"/>
					<Setter Property="FontSize" Value="24"/>
					<Setter Property="Foreground" Value="#FFFFFF"/>
					<Setter Property="Margin" Value="0,10,0,25"/>
				</Style>

				<Style Selector="TextBlock.Heading2">
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="FontSize" Value="18"/>
					<Setter Property="Foreground" Value="#FFFFFF"/>
					<Setter Property="Margin" Value="0,30,0,15"/>
				</Style>
			</md:MarkdownScrollViewer.Styles>

		</md:MarkdownScrollViewer>
	</Grid>

</Window>