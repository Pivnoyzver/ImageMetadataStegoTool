<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ImageMetadataStegoTool.MainWindow"
        Title="StegoTool" Width="1000" Height="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Roboto, Helvetica, Arial, sans-serif">

	<Window.Background>
		<LinearGradientBrush StartPoint="100%,0%" EndPoint="100%,100%">
			<GradientStop Offset="0.0" Color="#161520"/>
			<GradientStop Offset="0.5" Color="#201E2E"/>
			<GradientStop Offset="1.0" Color="#2A2435"/>
		</LinearGradientBrush>
	</Window.Background>

	<Window.Resources>
		<StreamGeometry x:Key="DocIcon">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</StreamGeometry>
		<StreamGeometry x:Key="PaperclipIcon">M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z</StreamGeometry>
		<StreamGeometry x:Key="ImageIcon">M8.5,13.5L11,16.5L14.5,12L19,18H5M21,19V5C21,3.89 20.1,3 19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19Z</StreamGeometry>
		<StreamGeometry x:Key="LockIcon">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z</StreamGeometry>
		<StreamGeometry x:Key="LockOpenIcon">M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8H9V6A3,3 0 0,1 12,3A3,3 0 0,1 15,6H17A5,5 0 0,0 12,1A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8Z</StreamGeometry>
		<StreamGeometry x:Key="DownloadIcon">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
		<StreamGeometry x:Key="SparkIcon">M 12 2 C 12 7.5 16.5 12 22 12 C 16.5 12 12 16.5 12 22 C 12 16.5 7.5 12 2 12 C 7.5 12 12 7.5 12 2 Z</StreamGeometry>
	</Window.Resources>

	<Window.Styles>
		<Style Selector="Border.Card">
			<Setter Property="Background" Value="#252436"/>
			<Setter Property="BorderBrush" Value="#3D3A53"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
		</Style>
		<Style Selector="Button.ActionBtn">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Width" Value="250"/>
			<Setter Property="Height" Value="48"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>

			<Setter Property="BorderBrush" Value="#3D3A53"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="Button.ActionBtn:pointerover /template/ Border#PART_ButtonBorder">
			<Setter Property="BorderBrush" Value="#4F5272"/>
			<Setter Property="Background" Value="#3D3A53"/>
		</Style>
		<Style Selector="Button.ClipCornerBtn">
			<Setter Property="Background" Value="#2F2D42"/>
			<Setter Property="BorderBrush" Value="#3D3A53"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="6"/>
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="Button.ClipCornerBtn:pointerover /template/ Border#PART_ButtonBorder">
			<Setter Property="Background" Value="#3D3A53"/>
			<Setter Property="BorderBrush" Value="#4F5272"/>
		</Style>
		<Style Selector="Button.IconBtn">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CaretBrush" Value="White"/>
		</Style>
	</Window.Styles>

	<Grid Margin="20,20,20,20">
		<Border BorderBrush="#585B7A" BorderThickness="0,3,3,0" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="0"/>
		<Border BorderBrush="#585B7A" BorderThickness="3,0,0,3" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="0"/>

		<Button Classes="IconBtn" Click="HelpBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" ZIndex="10">
			<Border Width="30" Height="30" CornerRadius="15" Background="#E4E4E4" BorderBrush="#8F83A8" BorderThickness="3">
				<TextBlock Text="?" Foreground="#8F83A8" FontSize="18" FontWeight="Black" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
			</Border>
		</Button>

		<Grid ColumnDefinitions="*, 54, *" IsHitTestVisible="False" ZIndex="2">
			<Grid Grid.Column="1" RowDefinitions="Auto, *, Auto" Margin="0,17,0,17">
				<PathIcon Grid.Row="0" Data="{StaticResource SparkIcon}" Foreground="#3D3A53" Width="25" Height="25" Margin="0,0,0,10"/>
				<Border Grid.Row="1" Width="2" Background="#3D3A53" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
				<PathIcon Grid.Row="2" Data="{StaticResource SparkIcon}" Foreground="#3D3A53" Width="25" Height="25" Margin="0,10,0,0"/>
			</Grid>
		</Grid>

		<TabControl Background="Transparent" ZIndex="1">
			<TabControl.Styles>
				<Style Selector="TabControl">
					<Setter Property="Padding" Value="0"/>
				</Style>

				<Style Selector="TabItem">
					<Setter Property="Foreground" Value="#A0A0B5"/>
					<Setter Property="FontSize" Value="18"/>
					<Setter Property="FontWeight" Value="Bold"/>
					<Setter Property="Margin" Value="0,0,10,15"/>
					<Setter Property="Padding" Value="0"/>
					<Setter Property="Width" Value="200"/>
					<Setter Property="Height" Value="48"/>
					<Setter Property="HorizontalContentAlignment" Value="Center"/>
					<Setter Property="VerticalContentAlignment" Value="Center"/>
					<Setter Property="CornerRadius" Value="8"/>
					<Setter Property="Background" Value="#252436"/>
					<Setter Property="BorderBrush" Value="#3D3A53"/>
					<Setter Property="BorderThickness" Value="1"/>
					<Setter Property="Cursor" Value="Hand"/>
				</Style>

				<Style Selector="TabItem /template/ Border#PART_SelectedPipe">
					<Setter Property="IsVisible" Value="False"/>
					<Setter Property="Opacity" Value="0"/>
					<Setter Property="Height" Value="0"/>
				</Style>
				<Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
					<Setter Property="IsVisible" Value="False"/>
					<Setter Property="Opacity" Value="0"/>
					<Setter Property="Height" Value="0"/>
				</Style>

				<Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
					<Setter Property="Background" Value="#3D3A53"/>
					<Setter Property="BorderBrush" Value="#4F5272"/>
				</Style>
				<Style Selector="TabItem:pointerover > TextBlock">
					<Setter Property="Foreground" Value="#E0E0E0"/>
				</Style>

				<Style Selector="TabItem:selected">
					<Setter Property="Foreground" Value="White"/>
				</Style>
				<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
					<Setter Property="Background" Value="#585B7A"/>
					<Setter Property="BorderBrush" Value="#6A6D8E"/>
					<Setter Property="BorderThickness" Value="1"/>
				</Style>

				<Style Selector="TabItem:focus /template/ Border#PART_LayoutRoot">
					<Setter Property="BorderThickness" Value="1"/>
				</Style>
			</TabControl.Styles>

			<TabItem Header="Шифрование">
				<Grid ColumnDefinitions="*, 54, *" Margin="0,15,0,0">

					<Grid Grid.Column="0" RowDefinitions="200, 15, *, 15, Auto">
						<Border Grid.Row="0" Classes="Card">
							<Grid DragDrop.AllowDrop="True" DragDrop.Drop="EncInput_Drop">
								<Button Classes="ClipCornerBtn" Click="EncAttachFileBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ZIndex="5">
									<PathIcon Data="{StaticResource PaperclipIcon}" Foreground="#A0A0B5" Width="16" Height="16"/>
								</Button>

								<Grid RowDefinitions="Auto, *" Margin="15,12,15,15">
									<StackPanel Grid.Row="0">
										<Border BorderBrush="#3D3A53" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5">
											<StackPanel Orientation="Horizontal" Spacing="8">
												<PathIcon Data="{StaticResource DocIcon}" Foreground="#A0A0B5" Width="14" Height="14"/>
												<TextBlock Text="Текст" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
											</StackPanel>
										</Border>
										<TextBlock Text="Введите/вставьте текст или прикрепите файл." Foreground="#9797A1" FontSize="11"/>
									</StackPanel>

									<Border Grid.Row="1" Background="#1D1B28" CornerRadius="6" Margin="0,8,0,0" Padding="5">
										<TextBox x:Name="EncInputTextBox" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
									</Border>
								</Grid>
							</Grid>
						</Border>

						<Border Grid.Row="2" Classes="Card" DragDrop.AllowDrop="True" DragDrop.Drop="EncImage_Drop">
							<Grid ColumnDefinitions="*, 170">
								<Border Grid.Column="0" Background="#1D1B28" CornerRadius="6" Margin="15">
									<Image x:Name="EncTargetImagePreview" Stretch="Uniform"/>
								</Border>
								<Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#3D3A53">
									<Grid>
										<Button Classes="ClipCornerBtn" Click="EncAttachImageBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ZIndex="5">
											<PathIcon Data="{StaticResource PaperclipIcon}" Foreground="#A0A0B5" Width="16" Height="16"/>
										</Button>

										<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,35,10,10">
											<PathIcon Data="{StaticResource ImageIcon}" Width="44" Height="44" Foreground="#A0A0B5" Margin="0,0,0,10" HorizontalAlignment="Center"/>
											<StackPanel MinHeight="80">
												<TextBlock Text="Изображение" FontWeight="Bold" Foreground="White" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"/>
												<TextBlock Text="Прикрепите изображение" Foreground="#9797A1" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
												<TextBlock x:Name="EncTargetImageText" Foreground="#A0A0B5" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0"/>
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<Button Grid.Row="4" Classes="ActionBtn" Background="#4F5272" Click="EncodeBtn_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource LockIcon}" Foreground="#A0A0B5" Width="18" Height="18" VerticalAlignment="Center"/>
								<TextBlock Text="Зашифровать" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>

					<Grid Grid.Column="2" RowDefinitions="200, 15, *, 15, Auto">
						<Border Grid.Row="0" Classes="Card">
							<Grid RowDefinitions="Auto, *" Margin="15,12,15,15">
								<StackPanel Grid.Row="0">
									<Border BorderBrush="#3D3A53" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<PathIcon Data="{StaticResource DocIcon}" Foreground="#A0A0B5" Width="14" Height="14"/>
											<TextBlock Text="Имя файла" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
									<TextBlock Text="Имя зашифрованного изображения" Foreground="#9797A1" FontSize="11"/>
								</StackPanel>
								<Border Grid.Row="1" Background="#1D1B28" CornerRadius="6" Margin="0,8,0,0" Padding="10">
									<TextBlock x:Name="EncOutputNameText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Top"/>
								</Border>
							</Grid>
						</Border>

						<Border Grid.Row="2" Classes="Card">
							<Grid ColumnDefinitions="*, 170">
								<Border Grid.Column="0" Background="#1D1B28" CornerRadius="6" Margin="15">
									<Image x:Name="EncOutputImagePreview" Stretch="Uniform"/>
								</Border>
								<Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#3D3A53">
									<Grid>
										<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
											<PathIcon Data="{StaticResource ImageIcon}" Width="44" Height="44" Foreground="#A0A0B5" Margin="0,0,0,10" HorizontalAlignment="Center"/>
											<StackPanel MinHeight="80">
												<TextBlock Text="Зашифрованное изображение" FontWeight="Bold" Foreground="White" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"/>
												<TextBlock Text="Сохраните итоговое изображение" Foreground="#9797A1" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<Button Grid.Row="4" Classes="ActionBtn" Background="#545778" Click="EncSaveBtn_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource DownloadIcon}" Foreground="#A0A0B5" Width="18" Height="18" VerticalAlignment="Center"/>
								<TextBlock Text="Сохранить как" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</TabItem>

			<TabItem Header="Дешифрование">
				<Grid ColumnDefinitions="*, 54, *" Margin="0,15,0,0">

					<Grid Grid.Column="0" RowDefinitions="200, 15, *, 15, Auto">
						<Border Grid.Row="0" Classes="Card">
							<Grid RowDefinitions="Auto, *" Margin="15,12,15,15">
								<StackPanel Grid.Row="0">
									<Border BorderBrush="#3D3A53" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<PathIcon Data="{StaticResource DocIcon}" Foreground="#A0A0B5" Width="14" Height="14"/>
											<TextBlock Text="Имя файла" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
									<TextBlock Text="Имя зашифрованного изображения" Foreground="#9797A1" FontSize="11"/>
								</StackPanel>
								<Border Grid.Row="1" Background="#1D1B28" CornerRadius="6" Margin="0,8,0,0" Padding="10">
									<TextBlock x:Name="DecTargetImageText" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Top"/>
								</Border>
							</Grid>
						</Border>

						<Border Grid.Row="2" Classes="Card" DragDrop.AllowDrop="True" DragDrop.Drop="DecImage_Drop">
							<Grid ColumnDefinitions="*, 170">
								<Border Grid.Column="0" Background="#1D1B28" CornerRadius="6" Margin="15">
									<Image x:Name="DecTargetImagePreview" Stretch="Uniform"/>
								</Border>
								<Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#3D3A53">
									<Grid>
										<Button Classes="ClipCornerBtn" Click="DecAttachImageBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" ZIndex="5">
											<PathIcon Data="{StaticResource PaperclipIcon}" Foreground="#A0A0B5" Width="16" Height="16"/>
										</Button>

										<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,35,10,10">
											<PathIcon Data="{StaticResource ImageIcon}" Width="44" Height="44" Foreground="#A0A0B5" Margin="0,0,0,10" HorizontalAlignment="Center"/>
											<StackPanel MinHeight="80">
												<TextBlock Text="Изображение" FontWeight="Bold" Foreground="White" TextAlignment="Center" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,5"/>
												<TextBlock Text="Прикрепите изображение" Foreground="#9797A1" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<Button Grid.Row="4" Classes="ActionBtn" Background="#4F5272" Click="DecodeBtn_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource LockOpenIcon}" Foreground="#A0A0B5" Width="18" Height="18" VerticalAlignment="Center"/>
								<TextBlock Text="Расшифровать" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>

					<Grid Grid.Column="2" RowDefinitions="200, 15, *, 15, Auto">
						<Border Grid.Row="0" Grid.RowSpan="3" Classes="Card">
							<Grid RowDefinitions="Auto, *" Margin="15,12,15,15">
								<StackPanel Grid.Row="0">
									<Border BorderBrush="#3D3A53" BorderThickness="1" CornerRadius="4" Padding="5,2" HorizontalAlignment="Left" Margin="0,0,0,5">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<PathIcon Data="{StaticResource DocIcon}" Foreground="#A0A0B5" Width="14" Height="14"/>
											<TextBlock Text="Текст" FontWeight="Bold" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
										</StackPanel>
									</Border>
									<TextBlock Text="Сохраните/просмотрите расшифрованный текст." Foreground="#9797A1" FontSize="11"/>
								</StackPanel>

								<Border Grid.Row="1" Background="#1D1B28" CornerRadius="6" Margin="0,8,0,0" Padding="5">
									<TextBox x:Name="DecOutputTextBox" Background="Transparent" BorderThickness="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
								</Border>
							</Grid>
						</Border>

						<Button Grid.Row="4" Classes="ActionBtn" Background="#545778" Click="DecSaveBtn_Click">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<PathIcon Data="{StaticResource DownloadIcon}" Foreground="#A0A0B5" Width="18" Height="18" VerticalAlignment="Center"/>
								<TextBlock Text="Сохранить как" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>