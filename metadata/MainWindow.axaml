<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="metadata.MainWindow"
        Title="metadata">

    <Window.Background>
        <SolidColorBrush Color="#2c2c2c"/>
    </Window.Background>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="10,10,0,10"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#E6E6E6"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style Selector="Border.ContainerBorder">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,20"/>
            <Setter Property="Padding" Value="60,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="TextBlock.DecText">
            <Setter Property="FontFamily" Value="Impact, Arial Black, sans-serif"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style Selector="Button.AttachBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.InputField">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Impact, Arial Black, sans-serif"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <TabControl Background="Transparent">
        <TabControl.Items>
            <TabItem Header="encryption">
                <Grid ColumnDefinitions="*, 2, *">
                    <!-- Left Panel -->
                    <DockPanel Grid.Column="0" Margin="10">
                        <!-- Bottom button -->
                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="EncodeBtn" Click="EncodeBtn_Click" Content="ENCODE" />

                        <Grid RowDefinitions="*,*">
                            <!-- Top Box -->
                            <Border Grid.Row="0" Classes="ContainerBorder">
                                <Grid Background="#666666">
                                    <TextBox Classes="InputField" x:Name="EncInputTextBox" Watermark="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,70,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Ellipse Width="20" Height="20" Fill="#D9D9D9"/>
                                        <Button Classes="AttachBtn" x:Name="EncAttachFileBtn" Click="EncAttachFileBtn_Click" Content="" Opacity="0" ToolTip.Tip="Прикрепить файл/текст"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Box -->
                            <Border Grid.Row="1" Classes="ContainerBorder">
                                <Grid RowDefinitions="*, Auto" Background="#333333">
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Ellipse Width="20" Height="20" Fill="#D9D9D9"/>
                                        <Button Classes="AttachBtn" x:Name="EncAttachImageBtn" Click="EncAttachImageBtn_Click" Content="" Opacity="0" ToolTip.Tip="Прикрепить картинку"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#D9D9D9" Height="24" Margin="10,0,10,10" CornerRadius="4">
                                        <TextBlock x:Name="EncTargetImageText" Text="" Classes="DecText" Foreground="Black"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#2c2c2c" Width="2" VerticalAlignment="Stretch"/>

                    <!-- Right Panel -->
                    <DockPanel Grid.Column="2" Margin="10">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                            <Button Content="" x:Name="EncRenameBtn" Click="EncRenameBtn_Click" Background="#D9D9D9" Width="250" Height="24" CornerRadius="4" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="EncSaveBtn" Click="EncSaveBtn_Click" Content="SAVE" />

                        <Border Classes="ContainerBorder">
                            <Grid RowDefinitions="*,*">
                                <!-- Top Box -->
                                <Border Grid.Row="0" Background="#666666" BorderThickness="0">
                                    <TextBlock x:Name="EncOutputNameText" Text="" Classes="DecText"/>
                                </Border>
                                <!-- Bottom Box -->
                                <Border Grid.Row="1" Background="#333333"/>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="decryption">
                <Grid ColumnDefinitions="*, 2, *">
                    <!-- Left Panel -->
                    <DockPanel Grid.Column="0" Margin="10">
                        <!-- Bottom button -->
                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="DecodeBtn" Click="DecodeBtn_Click" Content="DECODE" />

                        <Grid RowDefinitions="*,*">
                            <Border Grid.Row="0" Classes="ContainerBorder">
                                <Grid Background="#666666">
                                    <TextBlock x:Name="DecTargetImageText" Text="" Classes="DecText"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Ellipse Width="20" Height="20" Fill="#D9D9D9"/>
                                        <Button Classes="AttachBtn" x:Name="DecAttachImageBtn" Click="DecAttachImageBtn_Click" Content="" Opacity="0" ToolTip.Tip="Прикрепить картинку"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Classes="ContainerBorder">
                                <Grid Background="#333333">
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <!-- Divider -->
                    <Rectangle Grid.Column="1" Fill="#2c2c2c" Width="2" VerticalAlignment="Stretch"/>

                    <!-- Right Panel -->
                    <DockPanel Grid.Column="2" Margin="10">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
                            <Button Content="" x:Name="DecRenameBtn" Click="DecRenameBtn_Click" Background="#D9D9D9" Width="250" Height="24" CornerRadius="4" />
                        </StackPanel>

                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="DecSaveBtn" Click="DecSaveBtn_Click" Content="SAVE" />

                        <Border Classes="ContainerBorder">
                            <Grid RowDefinitions="*,*">
                                <!-- Top Box -->
                                <Border Grid.Row="0" Background="#666666" BorderThickness="0">
                                    <TextBlock x:Name="DecOutputFileNameText" Text="" Classes="DecText"/>
                                </Border>
                                <!-- Bottom Box -->
                                <Border Grid.Row="1" Background="#666666">
                                    <TextBox Classes="InputField" x:Name="DecOutputTextBox" IsReadOnly="True" Watermark="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl.Items>
    </TabControl>
</Window>
