<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="620"
        Width="1000" Height="620"
        x:Class="metadata.MainWindow"
        Title="metadata">

    <Window.Background>
        <SolidColorBrush Color="#434343"/>
    </Window.Background>

    <Window.Styles>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Background" Value="#A0A0A0"/>
            <Setter Property="Foreground" Value="#434343"/>
            <Setter Property="Padding" Value="25,0"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem:nth-child(1)">
            <Setter Property="CornerRadius" Value="6,0,0,6"/>
            <Setter Property="Margin" Value="23,10,0,10"/>
        </Style>
        <Style Selector="TabItem:nth-child(2)">
            <Setter Property="CornerRadius" Value="0,6,6,0"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TabItem:pointerover">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- Дополнительное переопределение для внутренних элементов шаблона в Avalonia (чтобы точно перебить стандартный hover) -->
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#D9D9D9"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style Selector="Border.ContainerBorder">
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="#D9D9D9"/>
        </Style>

        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,10,0,20"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="TextBlock.DecText">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style Selector="Button.AttachBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D9D9D9"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.InputField">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <TabControl Background="Transparent" Margin="0,10,10,10">
        <TabControl.Items>
            <TabItem Header="encryption">
                <Grid ColumnDefinitions="*, 2, *">
                    <!-- Left Panel -->
                    <DockPanel Grid.Column="0" Margin="10">
                        <!-- Bottom button -->
                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="EncodeBtn" Click="EncodeBtn_Click" Content="ENCODE" />

                        <Grid RowDefinitions="*,*">
                            <!-- Top Box -->
                            <Border Grid.Row="0" Classes="ContainerBorder">
                                <Grid Background="#666666">
                                    <TextBox Classes="InputField" x:Name="EncInputTextBox" Watermark="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,70,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Button Classes="AttachBtn" x:Name="EncAttachFileBtn" Click="EncAttachFileBtn_Click" Content="📎" ToolTip.Tip="Прикрепить файл/текст"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bottom Box -->
                            <Border Grid.Row="1" Classes="ContainerBorder">
                                <Grid RowDefinitions="*, Auto" Background="#333333">
                                    <Image x:Name="EncTargetImagePreview" Grid.Row="0" Margin="5" Stretch="Uniform"/>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Button Classes="AttachBtn" x:Name="EncAttachImageBtn" Click="EncAttachImageBtn_Click" Content="📎" ToolTip.Tip="Прикрепить картинку"/>
                                    </StackPanel>
                                    <Border Grid.Row="1" Background="#D9D9D9" Height="24" Margin="10,0,10,10" CornerRadius="4">
                                        <TextBlock x:Name="EncTargetImageText" Text="" Classes="DecText"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <!-- Divider -->
                    <!-- <Rectangle Grid.Column="1" Fill="#2c2c2c" Width="2" VerticalAlignment="Stretch"/> -->

                    <!-- Right Panel -->
                    <Grid Grid.Column="2">
                        <Button x:Name="EncHelpBtn" Click="HelpBtn_Click" Background="#D9D9D9" Foreground="Black" Width="30" Height="30" CornerRadius="15" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,10,0">
                            <TextBlock Text="?" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <DockPanel Margin="10">
                            <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="EncSaveBtn" Click="EncSaveBtn_Click" Content="SAVE AS" />

                            <Grid RowDefinitions="*,*">
                                <!-- Top Box -->
                                <Border Grid.Row="0" Classes="ContainerBorder">
                                    <Grid Background="#666666">
                                        <TextBlock x:Name="EncOutputNameText" Text="" Classes="DecText"/>
                                    </Grid>
                                </Border>
                                <!-- Bottom Box -->
                                <Border Grid.Row="1" Classes="ContainerBorder">
                                    <Grid Background="#333333">
                                        <Image x:Name="EncOutputImagePreview" Margin="5" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="decryption">
                <Grid ColumnDefinitions="*, 2, *">
                    <!-- Left Panel -->
                    <DockPanel Grid.Column="0" Margin="10">
                        <!-- Bottom button -->
                        <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="DecodeBtn" Click="DecodeBtn_Click" Content="DECODE" />

                        <Grid RowDefinitions="*,*">
                            <!-- Top Box -->
                            <Border Grid.Row="0" Classes="ContainerBorder">
                                <Grid Background="#666666">
                                    <TextBox Classes="InputField" x:Name="DecTargetImageText" IsReadOnly="True" Watermark="Прикрепленный файл..." HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,70,5"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Spacing="5">
                                        <Button Classes="AttachBtn" x:Name="DecAttachImageBtn" Click="DecAttachImageBtn_Click" Content="📎" ToolTip.Tip="Прикрепить картинку"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Bottom Box -->
                            <Border Grid.Row="1" Classes="ContainerBorder">
                                <Grid Background="#333333">
                                    <Image x:Name="DecTargetImagePreview" Margin="5" Stretch="Uniform"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DockPanel>

                    <!-- Divider -->
                    <!-- <Rectangle Grid.Column="1" Fill="#2c2c2c" Width="2" VerticalAlignment="Stretch"/> -->

                    <!-- Right Panel -->
                    <Grid Grid.Column="2">
                        <Button x:Name="DecHelpBtn" Click="HelpBtn_Click" Background="#D9D9D9" Foreground="Black" Width="30" Height="30" CornerRadius="15" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,10,0">
                            <TextBlock Text="?" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <DockPanel Margin="10">
                            <Button DockPanel.Dock="Bottom" Classes="ActionBtn" x:Name="DecSaveBtn" Click="DecSaveBtn_Click" Content="SAVE AS" />

                            <Grid>
                                <Border Classes="ContainerBorder">
                                    <Grid Background="#666666">
                                        <TextBox Classes="InputField" x:Name="DecOutputTextBox" IsReadOnly="True" Watermark="Результат расшифровки..." HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl.Items>
    </TabControl>
</Window>
